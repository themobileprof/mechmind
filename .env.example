# MechMind environment
HTTP_ADDR=:8080
# Postgres DB name remains "autoservice" for this codebase install
DATABASE_URL=postgres://autoservice:autoservice@127.0.0.1:5432/autoservice?sslmode=disable
JWT_SECRET=replace-with-long-random-string
JWT_TTL=24h
BOOTSTRAP_ADMIN_EMAIL=admin@yourshop.example
BOOTSTRAP_ADMIN_PASSWORD=replace-me-min-8-chars
BOOTSTRAP_ADMIN_NAME="Super Admin"
API_URL=http://localhost:8080

# Optional LLM narrative (off by default — findings work without it)
# OpenAI-compatible /chat/completions only (OpenAI, DeepSeek, etc.)
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
